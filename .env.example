# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，绝不入库。

# DeepSeek 云端总结（P2 使用）
# 2026 实测：价目表当前只有 deepseek-flash 与 deepseek-v4-pro；
# 旧名 deepseek-chat / deepseek-reasoner 会被降级路由到 flash。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled

# 凭证加密密钥：用于加密 B 站 SESSDATA（方案 §5.3①：密钥与数据分离）
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
VD_SECRET_KEY=

# ============ 大号 / 小号 分离（重要）============
# B 站协议 §2.7 的处罚权是按账号的：谁被用来发自动化请求，风险就落在谁头上。
# 因此本项目强制区分两个角色：
#
#   管理员（大号）VD_OWNER_BILI_UID   → 只决定"配额不限"，凭据绝不落盘、绝不用于取数
#   操作号（小号）VD_OPERATOR_BILI_UID → 唯一允许取数的账号，唯一存在服务器上的凭据
#
# 代码是白名单而非"优先选"：不在白名单里的凭据一律拒绝用于取数，
# 避免"取第一个凭证"那种在大号登录后静默开始用大号抓取的行为。
VD_OWNER_BILI_UID=
VD_OPERATOR_BILI_UID=
# 全部管理员 UID（逗号分隔，含大号与小号），仅用于配额判定
VD_ADMIN_UIDS=

# 操作号是否算管理员（默认 true）。设 false 可让"非管理员账号"专门负责取数，
# 此时它不享受不限配额、也不能查看他人任务 —— 两者本就应该分开。
VD_OPERATOR_IS_ADMIN=true

# ============ P3 Web 层 ============
# 受邀使用者 UID（逗号分隔）。管理员自动可用，无需列在这里。
# 未受邀者即使扫码登录也不能提交任务（方案 §5.3⑦ 邀请制）。
VD_INVITED_UIDS=

# 同一视频在这个秒数内刚成功处理过，就复用结果而不是重跑（默认 600 秒，设 0 关闭）。
# 目的是防止连点两次提交白花 LLM 费用；失败的任务永远可以重试。
VD_TASK_REUSE_SECONDS=600

# 配额（按登录的 B 站账号分级）
VD_GUEST_DAILY_VIDEO_LIMIT=3
VD_GUEST_DAILY_SECONDS_LIMIT=10800
