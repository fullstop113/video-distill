# ============================================================================
# video-distill 配置示例
# ============================================================================
#
# 用法：复制成 .env 再填值
#
#     cp .env.example .env          # Linux / macOS
#     Copy-Item .env.example .env   # Windows PowerShell
#
# .env 已在 .gitignore 中，**绝不会**被提交。请勿把它改名或移出项目根目录。
#
# ## 最少要填哪些？
#
#   · 只用"有字幕的视频"功能  → 只需 DEEPSEEK_API_KEY + VD_SECRET_KEY
#   · 还要处理"无字幕视频"    → 再加 DASHSCOPE_API_KEY + VD_PUBLIC_BASE_URL
#   · 自己一个人用            → 再填 VD_OWNER_BILI_UID / VD_OPERATOR_BILI_UID
#
# 填完后自检：
#
#     python scripts/check_env.py         # 检查必填项与连通性
#     python scripts/check_env_docs.py    # 检查本文档有没有漏掉代码用到的变量
#
# 逐项说明见 docs/configuration.md。
# ============================================================================


# ============================================================================
# 1. 密钥类（必填）
# ============================================================================

# ---- DeepSeek：负责"逐字稿 → 总结与要点" ----
# 申请地址：https://platform.deepseek.com/api_keys
# 不填会怎样：任务在第 3 步失败，报"未配置 DEEPSEEK_API_KEY"。
#
# 2026 实测：价目表当前只有 deepseek-flash 与 deepseek-v4-pro；
# 旧名 deepseek-chat / deepseek-reasoner 会被**静默降级**路由到 flash。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 是否开启模型的"思考模式"。默认关闭。
#
# ⚠️ 这不是可有可无的开关，它直接影响成本与成功率：
#   · DeepSeek 默认**开启**思考且 effort=high；
#   · 思考内容会**占用 max_tokens** —— 预算小时思考把预算吃光，
#     content 直接返回空字符串（实测踩过）；
#   · 本项目做的是"抽取 + 压缩"，不是难题推理，思考收益很低。
#
# 所以默认 disabled。想对比效果可以设 enabled，但要相应调大输出预算
# （见 vd/summarize.py 的 output_budget），否则会拿到空 content。
DEEPSEEK_THINKING=disabled


# ---- 凭据加密密钥（必填，但不用申请，自己生成）----
#
# 这是什么：一把**对称加密密钥**，用来加密存在磁盘上的 B 站登录凭据
# （SESSDATA 等 cookie）。设计意图是"密钥与数据分离"：
# 即使有人拿到了 data/credentials/ 下的文件，没有这把密钥也解不开。
#
# 怎么生成（复制到终端跑，会输出一行随机串）：
#
#     python -c "import secrets;print(secrets.token_urlsafe(48))"
#
# ⚠️ 丢了会怎样：**已保存的 B 站登录会全部失效**，需要重新扫码登录。
#    凭据文件还在，但解不开了。所以换机器时要把这个值一起带走。
#
# ⚠️ 换掉会怎样：同上，等同于让所有已存的凭据作废。
#
# ⚠️ 不要提交到 git。它和加密后的凭据必须分开保存，
#    否则"加密"就只是形式 —— 两个都泄露等于没加密。
VD_SECRET_KEY=


# ============================================================================
# 2. 账号角色（建议填，多人使用时必填）
# ============================================================================
#
# ## 为什么分成两个账号
#
# B 站协议里"处罚权按账号走"：谁被用来发自动化请求，风险就落在谁头上。
# 所以本项目**强制**区分两个角色，而不是"随便用哪个账号"：
#
#   大号（管理员） VD_OWNER_BILI_UID
#       → 只用来决定"配额不限"。凭据**绝不落盘、绝不用于取数**。
#
#   小号（操作号） VD_OPERATOR_BILI_UID
#       → **唯一**允许取数的账号，也是**唯一**存在服务器上的凭据。
#
# 代码里是**白名单**而非"优先选"：不在白名单里的凭据一律拒绝用于取数。
# 这避免了"取第一个凭据"那种写法 —— 一旦你用大号登录过，
# 它会静默地开始用大号抓数据，而你不会收到任何提示。
#
# ## 怎么查自己的 UID
#
# 登录 B 站后打开 https://api.bilibili.com/x/web-interface/nav
# 返回 JSON 里的 data.mid 就是。
#
# ## 不填会怎样
#
# 单人自用可以留空（此时登录的账号自己就是操作号）。
# 但**凭据隔离的保证会失效** —— 用哪个账号登录就用哪个账号取数。
#
# ⚠️ 如果你打算把服务开放给别人用，**一定要填**，
#    否则你自己的号会替所有人承担风控风险。
VD_OWNER_BILI_UID=
VD_OPERATOR_BILI_UID=

# 全部管理员 UID（逗号分隔，含大号与小号）。仅用于配额判定。
# 管理员不受每日配额与余额限制。
VD_ADMIN_UIDS=

# 操作号是否也算管理员（默认 true）。
#
# 设 false 可以让"操作号"专门负责取数、不享受任何特权 ——
# 它本来就不该既能不限量又能看别人的任务。
#
# ⚠️ 注意它默认是 true，所以**用操作号测不出"非管理员"的行为**。
#    要测权限边界必须另用一个 UID（写测试时踩过这个坑）。
VD_OPERATOR_IS_ADMIN=true


# ============================================================================
# 3. Web 服务
# ============================================================================

# 受邀使用者 UID（逗号分隔）。管理员自动可用，无需列在这里。
# 未受邀者即使扫码登录也不能提交任务。
#
# 留空 = 只有管理员能用。
VD_INVITED_UIDS=

# 是否信任局域网来源（默认 false）。
#
# 默认只信任 127.0.0.1 / ::1 / localhost —— 这些来源**免登录**
# （凭据就在本机磁盘上，登录只是仪式感）。
#
# ⚠️ 设 true 的后果：**同一局域网内任何人都能免登录使用本服务**，
#    包括提交任务、查看产物。只在完全可信的家庭/办公网络里打开。
#
# ⚠️ 另一个容易误解的点：如果你用 --host 0.0.0.0 启动，
#    然后**从本机浏览器**访问公网地址，数据包出去再回来，
#    对端地址仍是 127.0.0.1 → **仍然免登录**。
#    所以在本机测"远程是否要登录"，测出来的可能不是真实结果。
VD_WEB_TRUST_LAN=false

# 同一视频在这个秒数内刚成功处理过，就复用结果而不是重跑（设 0 关闭）。
# 目的是防止连点两次提交白花 LLM 费用。失败的任务永远可以重试。
VD_TASK_REUSE_SECONDS=600

# 配额（按登录的 B 站账号分级）。管理员不受限。
# 这层与"余额"是**两套独立的限制**，都会生效：
#   配额  → 限次数与总时长，防滥用
#   余额  → 限花钱的部分（只有无字幕视频会消耗）
VD_GUEST_DAILY_VIDEO_LIMIT=3
VD_GUEST_DAILY_SECONDS_LIMIT=10800


# ============================================================================
# 4. 云语音识别（可选：只处理有字幕视频就不需要这节）
# ============================================================================
#
# 仅用于**没有站内字幕**的视频。有字幕的视频走 B 站字幕，**完全不花钱**。
#
# ## 为什么不本地跑 ASR
#
# 实测 FunASR 峰值内存 5.3 GB（换大/小模型内存几乎不变，
# 说明大头是运行时而非权重）→ 服务器至少要 4核8G（约 450 元/年）。
# 云端按量付费 0.288 元/小时，偶尔用一次远比常驻服务器便宜，
# 而且**不为闲置付费** —— 所以最便宜的 2核2G 服务器就够。
#
# 详细数据与踩坑记录见 docs/asr-cloud.md。

# 阿里云百炼的 API Key。申请：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=paraformer-v2

# ---- 本服务的**公网可达**地址（用云 ASR 就必填）----
#
# ## 为什么必须有它
#
# Paraformer 只接受**公网可访问的 URL**（官方 FAQ：不支持 Base64、
# 不支持二进制流、不支持本地文件）。
#
# 而 B 站音频链接**外部拉不到** —— B 站 CDN 校验 Referer，实测：
#
#     裸请求（无 UA、无 Referer）  → HTTP 403
#     带 Referer: bilibili.com     → HTTP 200
#
# 所以直接提交 B 站链接会得到 FILE_403_FORBIDDEN（实测过两次）。
# 音频必须由**本服务中转一次**：
#
#     B站音频 → 本机下载 → https://你的地址/relay/<随机token> → 阿里云来取
#
# 这个变量就是那个"你的地址"。
#
# ## 怎么填
#
#   · 有公网 IP：http://123.45.67.89:8788
#   · 有域名：    https://vd.example.com
#   · ⚠️ **不能**填 127.0.0.1 或 10.x/192.168.x 内网地址 ——
#     阿里云访问不到，会得到 FILE_403_FORBIDDEN
#   · 本地开发想试：可以用内网穿透（如 cloudflared 临时隧道）
#
# ## 不填会怎样
#
# 遇到无字幕视频时**明确报错**并告诉你去配它，
# 而不是提交一个阿里云拉不到的地址然后返回含糊的 403。
#
# 填完自检：python scripts/check_deploy.py --remote
VD_PUBLIC_BASE_URL=

# 中转音频的最长存活时间（秒，默认 7200 = 2 小时）。
#
# 阿里云通常 1~3 分钟就取完了，2 小时是**兜底**：
# 万一进程异常退出、来不及清理，音频也不会长期挂在公网。
# 想更保守可调小（如 600），代价是网络很慢时可能中途过期。
VD_RELAY_TTL_SECONDS=7200

# ---- /relay 路由的额外收紧（可选）----
#
# 背景：/relay/<token> 是**免登录**的公开路由 —— 阿里云没有本站凭据，
# 只能靠 token 自证。防护是"不可猜测 + 短命 + 一次性"。
#
# ⚠️ 想"只允许阿里云 IP 访问"是**做不到的**：
#    · 走 Cloudflare 隧道时，服务看到的对端是 Cloudflare 边缘节点，不是阿里云；
#    · 即使直连，阿里云拉取的出口 IP 也不固定，写死了反而挡住真请求。
#
# 所以这里提供的是两个**收窄面**的开关，都不是安全边界：

# 严格模式（默认关）。开启后，没有"进行中的转写任务"时 /relay 一律 403。
# 这让随手扫描拿不到任何东西。代价：手工调试中转 URL 时会被挡（正常现象）。
VD_RELAY_STRICT=

# User-Agent 白名单前缀（默认空 = 不检查）。
# 填了以后只有 UA 以此开头的请求能取音频。
# 用途：如果你观察到阿里云带了固定的 UA，可以据此再收窄一层。
# 排查时它会把被拒的 UA 记进日志，可据此确定该填什么。
VD_RELAY_UA_PREFIX=


# ============================================================================
# 5. 计费与余额（可选：多人共享时才需要）
# ============================================================================
#
# 模型：新用户送一点余额 → 管理员发邀请码充值 → 无字幕视频按**视频时长**扣费。
# 有字幕的视频不花钱，所以余额只被"无字幕视频"消耗。
#
# ⚠️ 扣费口径是按**视频时长**而不是"语音时长"（阿里云实际只对语音计费，
#    实测语音约占 57%）。所以账面扣得比真实成本多 —— 这是**故意**的：
#    预扣偏保守，有利于账号主人控制成本。

# ASR 单价（元/秒）。控制台实价 0.00008 元/秒 = 0.288 元/小时。
# ⚠️ 计费口径是"被判定为**语音内容**的时长"，停顿与音乐不计费。
VD_ASR_PRICE_PER_SECOND=0.00008

# 每月免费额度（秒，默认 36000 = 10 小时）。仅用于在余额页显示进度提示，
# **不影响扣费计算** —— 因为免费额度按自然月重置，而余额是累计的，
# 两者不能混在一个数里算。
VD_ASR_FREE_SECONDS_PER_MONTH=36000

# 新用户初始余额（元）。给一点让新用户能试一次无字幕视频。
VD_INITIAL_BALANCE=1

# 允许负债的下限（元，正数表示"最多欠这么多"）。
# 留空则默认取 VD_INITIAL_BALANCE 的绝对值（即"最多把送的那点欠掉"）。
#
# 为什么允许负数：无字幕视频的音频一旦交给阿里云，钱就已经产生了。
# 与其在扣费时失败，不如允许小幅透支，把账记清楚。
VD_BALANCE_FLOOR=

# 邀请码参数：每个面额、一次生成几个、有效期（秒）
VD_INVITE_CREDIT=2.00
VD_INVITE_BATCH=5
VD_INVITE_TTL_SECONDS=3600
